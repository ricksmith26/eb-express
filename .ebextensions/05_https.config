files:
  # Install certbot for Let's Encrypt
  "/tmp/install_certbot.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      if ! command -v certbot &> /dev/null; then
        echo "Installing certbot..."
        dnf install -y python3 augeas-libs
        python3 -m venv /opt/certbot
        /opt/certbot/bin/pip install --upgrade pip
        /opt/certbot/bin/pip install certbot certbot-nginx
        ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
      else
        echo "Certbot already installed"
      fi

container_commands:
  01_install_certbot:
    command: "/tmp/install_certbot.sh"
    ignoreErrors: true

  02_setup_https:
    command: |
      #!/bin/bash
      DOMAIN="api.brigid-personal-assistant.com"
      CERT_PATH="/etc/letsencrypt/live/$DOMAIN"

      # Check if certificate exists and is valid
      if [ -d "$CERT_PATH" ] && openssl x509 -checkend 86400 -noout -in "$CERT_PATH/fullchain.pem" 2>/dev/null; then
        echo "Valid certificate found for $DOMAIN"
      else
        echo "Certificate not found or expired, attempting to obtain..."
        # Stop nginx temporarily to allow certbot to bind to port 80
        systemctl stop nginx

        # Obtain certificate using standalone mode
        certbot certonly --standalone --non-interactive --agree-tos --register-unsafely-without-email \
          -d $DOMAIN \
          || echo "Certbot failed, will continue without HTTPS"

        # Restart nginx
        systemctl start nginx
      fi

  03_fix_nginx_websocket_map:
    command: |
      # Fix the WebSocket connection_upgrade map to include the "" close case
      if ! grep -q '"" close;' /etc/nginx/nginx.conf; then
        sed -i '/map $http_upgrade $connection_upgrade {/,/}/c\
      map $http_upgrade $connection_upgrade {\
          default upgrade;\
          "" close;\
      }' /etc/nginx/nginx.conf
      fi

  04_setup_cert_renewal:
    command: |
      # Set up certbot auto-renewal cron job (runs daily at 3 AM)
      if ! crontab -l 2>/dev/null | grep -q certbot; then
        (crontab -l 2>/dev/null; echo "0 3 * * * certbot renew --quiet --post-hook 'systemctl reload nginx'") | crontab -
      fi
