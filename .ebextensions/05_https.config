files:
  "/etc/nginx/conf.d/https.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      server {
          listen 443 ssl;
          server_name api.brigid-personal-assistant.com;

          ssl_certificate /etc/letsencrypt/live/api.brigid-personal-assistant.com/fullchain.pem;
          ssl_certificate_key /etc/letsencrypt/live/api.brigid-personal-assistant.com/privkey.pem;

          ssl_protocols TLSv1.2 TLSv1.3;
          ssl_ciphers HIGH:!aNULL:!MD5;
          ssl_prefer_server_ciphers on;

          client_max_body_size 20M;

          location / {
              proxy_pass http://127.0.0.1:8080;
              proxy_http_version 1.1;

              # WebSocket headers
              proxy_set_header Upgrade $http_upgrade;
              proxy_set_header Connection $connection_upgrade;

              # Standard proxy headers
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;

              # WebSocket timeout settings (24 hours)
              proxy_read_timeout 86400;
              proxy_send_timeout 86400;

              # Disable buffering for WebSocket
              proxy_buffering off;
          }
      }

container_commands:
  01_fix_nginx_websocket_map:
    command: |
      # Fix the WebSocket connection_upgrade map to include the "" close case
      if ! grep -q '"" close;' /etc/nginx/nginx.conf; then
        sed -i '/map $http_upgrade $connection_upgrade {/,/}/c\
      map $http_upgrade $connection_upgrade {\
          default upgrade;\
          "" close;\
      }' /etc/nginx/nginx.conf
      fi
  02_reload_nginx:
    command: "nginx -t && service nginx reload || echo 'Nginx will be reloaded by platform'"
