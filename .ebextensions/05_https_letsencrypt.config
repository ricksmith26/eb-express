packages:
  yum:
    mod_ssl: []

files:
  "/tmp/certbot-install.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Install certbot if not already installed
      if ! command -v certbot &> /dev/null; then
        echo "Installing certbot..."
        python3 -m venv /opt/certbot
        /opt/certbot/bin/pip install --upgrade pip
        /opt/certbot/bin/pip install certbot certbot-nginx
        ln -sf /opt/certbot/bin/certbot /usr/bin/certbot
      else
        echo "Certbot already installed"
      fi

  "/tmp/setup-https.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      DOMAIN="api.brigid-personal-assistant.com"
      EMAIL="ricksmith26@hotmail.com"

      echo "Setting up HTTPS for $DOMAIN"

      # Check if certificate already exists
      if [ -d "/etc/letsencrypt/live/$DOMAIN" ]; then
        echo "Certificate already exists for $DOMAIN"
        exit 0
      fi

      # Stop nginx temporarily to allow certbot standalone mode
      systemctl stop nginx

      # Obtain certificate using standalone mode (port 80)
      certbot certonly --standalone \
        --non-interactive \
        --agree-tos \
        --email $EMAIL \
        --domains $DOMAIN \
        --keep-until-expiring

      CERT_EXIT_CODE=$?

      # Start nginx back up
      systemctl start nginx

      if [ $CERT_EXIT_CODE -eq 0 ]; then
        echo "Certificate obtained successfully"

        # Configure nginx to use the certificate
        cat > /etc/nginx/conf.d/https.conf << 'EOF'
      server {
        listen 443 ssl;
        server_name api.brigid-personal-assistant.com;

        ssl_certificate /etc/letsencrypt/live/api.brigid-personal-assistant.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/api.brigid-personal-assistant.com/privkey.pem;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        client_max_body_size 20M;

        # WebSocket support
        location / {
          proxy_pass http://127.0.0.1:8080;
          proxy_http_version 1.1;
          proxy_set_header Upgrade $http_upgrade;
          proxy_set_header Connection $connection_upgrade;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
        }
      }
      EOF

        # Test and reload nginx
        nginx -t && systemctl reload nginx
        echo "HTTPS configured successfully"
      else
        echo "Failed to obtain certificate"
        exit 1
      fi

  "/etc/cron.d/certbot-renew":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Renew Let's Encrypt certificates twice daily
      0 0,12 * * * root /opt/certbot/bin/certbot renew --quiet --post-hook "systemctl reload nginx"

container_commands:
  01_install_certbot:
    command: "/tmp/certbot-install.sh"
    ignoreErrors: false

  02_setup_https:
    command: "/tmp/setup-https.sh"
    ignoreErrors: true
    leader_only: true
