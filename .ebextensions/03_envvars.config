# .env.local file is included in deployment package and loaded by dotenv
# This configuration ensures proper deployment settings

option_settings:
  # Increase deployment timeout to 15 minutes
  aws:elasticbeanstalk:command:
    Timeout: 900

  # Health check configuration
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: HTTP:8080/

container_commands:
  01_verify_env_file:
    command: |
      echo "=== Verifying .env.local file ==="
      if [ -f /var/app/staging/.env.local ]; then
        echo ".env.local found in staging directory"
        ls -lh /var/app/staging/.env.local
      else
        echo "WARNING: .env.local NOT found in staging directory"
      fi

  02_check_node:
    command: |
      echo "=== Node.js version ==="
      node --version
      npm --version
