# Environment variables are set via GitHub Actions deployment
# This file is a placeholder to document what env vars are needed
#
# Required environment variables:
# - NODE_ENV
# - PORT
# - MONGO_DB_URL
# - API_URL
# - FRONTEND_URL
# - GOOGLE_CLIENT_ID
# - GOOGLE_CLIENT_SECRET
# - GOOGLE_CALLBACK_URL
# - JWT_SECRET
# - JWT_REFRESH_SECRET
# - LIVEKIT_URL
# - LIVEKIT_API_KEY
# - LIVEKIT_API_SECRET
