files:
  "/etc/nginx/conf.d/proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      client_max_body_size 20M;

  "/etc/nginx/conf.d/websockets.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # WebSocket support for Socket.IO
      map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
      }

      upstream nodejs {
        server 127.0.0.1:8080;
        keepalive 256;
      }

container_commands:
  01_reload_nginx:
    command: "service nginx reload"
