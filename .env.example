# API Configuration
API_URL=https://your-api-domain.com
FRONTEND_URL=https://your-frontend-domain.com
PORT=3000

# Database
MONGO_DB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://your-api-domain.com/auth/google/callback

# JWT Authentication
# IMPORTANT: Generate strong, random secrets for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-minimum-32-characters
JWT_REFRESH_SECRET=your-jwt-refresh-secret-minimum-32-characters-different-from-jwt-secret

# LiveKit (WebRTC)
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud

# Withings Health API
# Get credentials from: https://developer.withings.com/dashboard/
WITHINGS_CLIENT_ID=your-withings-client-id
WITHINGS_CLIENT_SECRET=your-withings-client-secret
WITHINGS_CALLBACK_URL=https://your-api-domain.com/withings/oauth/callback

# Node Environment
NODE_ENV=development

# Asterisk AMI (for call management)
ASTERISK_AMI_HOST=asterisk.yourdomain.com
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=brigid-backend
ASTERISK_AMI_PASSWORD=your-ami-password

# PostgreSQL (for telecare/PJSIP realtime)
# Used for BS 8521-2 telecare device management
POSTGRES_HOST=your-rds-instance.region.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
POSTGRES_USER=asterisk
POSTGRES_PASSWORD=your-postgres-password
