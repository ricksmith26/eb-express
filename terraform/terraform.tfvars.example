# Copy this file to terraform.tfvars and fill in the values

aws_region     = "eu-west-2"
app_name       = "eb-express"
environment    = "production"
instance_type  = "t3.micro"
github_org     = "ricksmith26"  # Replace with your GitHub username or org
github_repo    = "eb-express"

# Generate SSH key pair:
# ssh-keygen -t rsa -b 4096 -f ~/.ssh/eb-express-key -N ""
# Then paste the contents of ~/.ssh/eb-express-key.pub below
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2E... your-email@example.com"
